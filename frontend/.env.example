# Base URL for FileNotFound backend API
# Leave empty to use local Vite dev server proxy (/api -> http://localhost:5000)
VITE_API_BASE_URL=https://file-not-found-omega.vercel.app

# Mock mode: 'auto' (default: attempts real API, falls back if offline), 'true' (force mock), 'false' (strict backend)
VITE_USE_MOCK=auto

